\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Ablation Study: Defense Component Contribution. Horizontal bar chart showing detection rate impact of removing each CIF component from the full ensemble. The Cognitive Firewall contributes the largest marginal improvement (\(\mitDelta \text  {TPR} = +0.13\) when added), followed by Tripwires (\(+0.09\)), Provenance Tracking (\(+0.07\)), Sandbox (\(+0.06\)), Invariants (\(+0.05\)), Drift Detection (\(+0.04\)), and Trust Decay (\(+0.03\)). Components are classified by impact severity: \emph  {critical} (\(\mitDelta > 0.10\), Firewall), \emph  {major} (\(0.05 < \mitDelta \leq 0.10\), Tripwires and Provenance), and \emph  {moderate} (\(\mitDelta \leq 0.05\), remaining). The Firewall + Tripwires pair exhibits the strongest positive synergy (\(+0.09\) beyond additive prediction), detecting complementary attack patterns (pattern-based input filtering vs.~behavioral anomaly monitoring). Data from \texttt  {output/data/ablation\_results.json}.}}{51}{figure.7}\protected@file@percent }
\newlabel{fig:ablation-study}{{7}{51}{Ablation Study: Defense Component Contribution. Horizontal bar chart showing detection rate impact of removing each CIF component from the full ensemble. The Cognitive Firewall contributes the largest marginal improvement (\(\Delta \text {TPR} = +0.13\) when added), followed by Tripwires (\(+0.09\)), Provenance Tracking (\(+0.07\)), Sandbox (\(+0.06\)), Invariants (\(+0.05\)), Drift Detection (\(+0.04\)), and Trust Decay (\(+0.03\)). Components are classified by impact severity: \emph {critical} (\(\Delta > 0.10\), Firewall), \emph {major} (\(0.05 < \Delta \leq 0.10\), Tripwires and Provenance), and \emph {moderate} (\(\Delta \leq 0.05\), remaining). The Firewall + Tripwires pair exhibits the strongest positive synergy (\(+0.09\) beyond additive prediction), detecting complementary attack patterns (pattern-based input filtering vs.~behavioral anomaly monitoring). Data from \texttt {output/data/ablation\_results.json}}{figure.7}{}}
\newlabel{fig:ablation-study@cref}{{[figure][7][]7}{[1][51][]51}{}{}{}}
